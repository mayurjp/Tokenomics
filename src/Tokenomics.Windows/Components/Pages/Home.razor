@page "/"
@using Tokenomics.Core.Models
@using Tokenomics.Core.Providers
@using Tokenomics.Core.Storage
@inject ProviderRegistry ProviderRegistry
@inject IApiKeyStore ApiKeyStore
@inject IProviderSettingsStore ProviderSettingsStore

<h1>Token Economics Explorer</h1>
<p class="text-muted">A1 — Measurement: type a prompt, see the real token breakdown.</p>

@if (_configuredProviders.Count == 0)
{
    <div class="alert alert-warning">
        No API key saved yet. Go to <a href="settings">Settings</a> to add one.
    </div>
}
else
{
    <label class="form-label fw-bold">Provider</label>
    <select class="form-select" style="max-width: 20rem;" @bind="_selectedProviderId" @bind:after="OnProviderChangedAsync">
        @foreach (var provider in _configuredProviders)
        {
            <option value="@provider.ProviderId">@provider.DisplayName</option>
        }
    </select>
    <p class="text-muted mt-1">Model: @_model <a href="settings">(change)</a></p>

    <label for="prompt" class="form-label fw-bold mt-3">Prompt</label>
    <textarea id="prompt" class="form-control" rows="5" @bind="_prompt" placeholder="Type any prompt..."></textarea>

    <button class="btn btn-primary mt-3" @onclick="RunAsync" disabled="@_isRunning">
        @(_isRunning ? "Running..." : "Run")
    </button>

    @if (_errorMessage is not null)
    {
        <p class="text-danger fw-bold mt-3">@_errorMessage</p>
    }

    @if (_result is not null)
    {
        <h2 class="mt-4">Response</h2>
        <p>@_result.ResponseText</p>

        <h2>Token Stats</h2>
        <table class="table">
            <tbody>
                <tr><th>Model</th><td>@_result.Model</td></tr>
                <tr><th>Input tokens</th><td>@_result.Stats.InputTokens</td></tr>
                <tr><th>Output tokens</th><td>@_result.Stats.OutputTokens</td></tr>
                <tr><th>Total tokens</th><td>@_result.Stats.TotalTokens</td></tr>
                <tr><th>Cache read tokens</th><td>@Format(_result.Stats.CacheReadTokens)</td></tr>
                <tr><th>Cache write tokens</th><td>@Format(_result.Stats.CacheWriteTokens)</td></tr>
                <tr><th>Reasoning tokens</th><td>@Format(_result.Stats.ReasoningTokens)</td></tr>
            </tbody>
        </table>
    }
}

@code {
    private readonly List<ILlmProvider> _configuredProviders = [];
    private string _selectedProviderId = string.Empty;
    private string _model = string.Empty;
    private string _prompt = string.Empty;
    private bool _isRunning;
    private string? _errorMessage;
    private MeasureResult? _result;

    protected override async Task OnInitializedAsync()
    {
        foreach (var provider in ProviderRegistry.All)
        {
            if (await ApiKeyStore.HasKeyAsync(provider.ProviderId))
            {
                _configuredProviders.Add(provider);
            }
        }

        if (_configuredProviders.Count > 0)
        {
            _selectedProviderId = _configuredProviders[0].ProviderId;
            await LoadSelectedModelAsync();
        }
    }

    private async Task OnProviderChangedAsync() => await LoadSelectedModelAsync();

    private async Task LoadSelectedModelAsync()
    {
        var provider = ProviderRegistry.Get(_selectedProviderId);
        _model = await ProviderSettingsStore.GetSelectedModelAsync(_selectedProviderId) ?? provider.DefaultModel;
    }

    private async Task RunAsync()
    {
        if (string.IsNullOrWhiteSpace(_prompt))
        {
            _errorMessage = "Please type a prompt first.";
            return;
        }

        _isRunning = true;
        _errorMessage = null;
        _result = null;

        try
        {
            var apiKey = await ApiKeyStore.GetKeyAsync(_selectedProviderId)
                ?? throw new InvalidOperationException("No key saved for this provider — set one in Settings first.");

            var provider = ProviderRegistry.Get(_selectedProviderId);
            _result = await provider.MeasureAsync(apiKey, _model, _prompt);
        }
        catch (QuotaExceededException ex)
        {
            await ProviderSettingsStore.MarkModelUnavailableAsync(_selectedProviderId, _model);
            _errorMessage = $"{ex.Message} — {_model} has been marked unavailable and hidden from the picker in Settings (it can be un-hidden there if quota resets).";
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isRunning = false;
        }
    }

    private static string Format(int? value) => value?.ToString() ?? "not reported";
}
