@page "/compare"
@using Tokenomics.Core.Models
@using Tokenomics.Core.Providers
@using Tokenomics.Core.Storage
@inject ProviderRegistry ProviderRegistry
@inject IApiKeyStore ApiKeyStore
@inject IProviderSettingsStore ProviderSettingsStore

<h1>Compare</h1>
<p class="text-muted">Fan out one prompt to several models at once and compare token stats side by side.</p>

@if (_configuredProviders.Count == 0)
{
    <div class="alert alert-warning">
        No API key saved yet. Go to <a href="settings">Settings</a> to add one.
    </div>
}
else
{
    <label for="prompt" class="form-label fw-bold">Prompt</label>
    <textarea id="prompt" class="form-control" rows="5" @bind="_prompt" placeholder="Type any prompt..."></textarea>

    <div class="row mt-3">
        @foreach (var provider in _configuredProviders)
        {
            <div class="col-md-6 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="card-title h6">@provider.DisplayName</h2>

                        @if (_groupsByProvider.TryGetValue(provider.ProviderId, out var groups) && groups.Count > 0)
                        {
                            @foreach (var group in groups)
                            {
                                var groupKey = $"{provider.ProviderId}|{group.VendorLabel}";
                                var expanded = _expandedGroups.Contains(groupKey);
                                var shown = expanded ? group.Models : group.Models.Take(1);

                                @if (group.VendorLabel.Length > 0)
                                {
                                    <p class="small text-muted fw-bold mb-1 mt-2">@group.VendorLabel</p>
                                }
                                @foreach (var model in shown)
                                {
                                    var key = SelectionKey(provider.ProviderId, model.Id);
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="@key"
                                               checked="@_selected.Contains(key)"
                                               @onchange="e => ToggleSelection(key, e.Value is bool v && v)" />
                                        <label class="form-check-label" for="@key">@model.Id</label>
                                    </div>
                                }
                                @if (group.Models.Count > 1)
                                {
                                    <button class="btn btn-link btn-sm p-0" @onclick="() => ToggleExpanded(groupKey)">
                                        @(expanded ? "show only flagship" : $"show {group.Models.Count - 1} more")
                                    </button>
                                }
                            }
                        }
                        else
                        {
                            <p class="text-muted small mb-0">@_loadErrorByProvider.GetValueOrDefault(provider.ProviderId, "Loading models...")</p>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <button class="btn btn-primary mt-2" @onclick="RunFanoutAsync" disabled="@(_isRunning || _selected.Count == 0 || string.IsNullOrWhiteSpace(_prompt))">
        @(_isRunning ? "Running..." : $"Run Fan-out ({_selected.Count} selected)")
    </button>

    @if (_results.Count > 0)
    {
        <h2 class="mt-4">Results</h2>
        @foreach (var result in _results)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h3 class="h6">@result.ProviderDisplayName — @result.Model</h3>

                    @if (result.Error is not null)
                    {
                        <p class="text-danger mb-0">@result.Error</p>
                    }
                    else if (result.Result is not null)
                    {
                        <p>@result.Result.ResponseText</p>
                        <table class="table table-sm">
                            <tbody>
                                <tr><th>Input tokens</th><td>@result.Result.Stats.InputTokens</td></tr>
                                <tr><th>Output tokens</th><td>@result.Result.Stats.OutputTokens</td></tr>
                                <tr><th>Total tokens</th><td>@result.Result.Stats.TotalTokens</td></tr>
                                <tr><th>Cache read tokens</th><td>@Format(result.Result.Stats.CacheReadTokens)</td></tr>
                                <tr><th>Cache write tokens</th><td>@Format(result.Result.Stats.CacheWriteTokens)</td></tr>
                                <tr><th>Reasoning tokens</th><td>@Format(result.Result.Stats.ReasoningTokens)</td></tr>
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }
    }
}

@code {
    private sealed record FanoutResult(string ProviderId, string ProviderDisplayName, string Model, MeasureResult? Result, string? Error);
    private sealed record ModelGroup(string VendorLabel, List<ModelInfo> Models);

    private readonly List<ILlmProvider> _configuredProviders = [];
    private readonly Dictionary<string, List<ModelGroup>> _groupsByProvider = new();
    private readonly Dictionary<string, string> _loadErrorByProvider = new();
    private readonly HashSet<string> _selected = new();
    private readonly HashSet<string> _expandedGroups = new();
    private readonly List<FanoutResult> _results = [];

    private string _prompt = string.Empty;
    private bool _isRunning;

    private static string SelectionKey(string providerId, string model) => $"{providerId}|{model}";

    protected override async Task OnInitializedAsync()
    {
        foreach (var provider in ProviderRegistry.All)
        {
            if (await ApiKeyStore.HasKeyAsync(provider.ProviderId))
            {
                _configuredProviders.Add(provider);
            }
        }

        foreach (var provider in _configuredProviders)
        {
            var apiKey = await ApiKeyStore.GetKeyAsync(provider.ProviderId);
            if (apiKey is null)
            {
                continue;
            }

            try
            {
                var models = await provider.ListModelsAsync(apiKey);
                var unavailable = await ProviderSettingsStore.GetUnavailableModelsAsync(provider.ProviderId);
                var visible = models.Where(m => !unavailable.Contains(m.Id)).ToList();
                _groupsByProvider[provider.ProviderId] = BuildGroups(visible);
            }
            catch (Exception ex)
            {
                _loadErrorByProvider[provider.ProviderId] = ex.Message;
            }
        }
    }

    // Groups by vendor prefix (the part before "/" in an id like "google/gemini-3.5-flash").
    // Ids without a "/" (Gemini's own catalog) form one ungrouped list. Within a vendor
    // group, the model with the highest CapabilityScore is shown first — that's the one
    // displayed by default, with the rest available behind "show N more".
    private static List<ModelGroup> BuildGroups(List<ModelInfo> models)
    {
        var withVendor = models.Where(m => m.Id.Contains('/')).ToList();
        var withoutVendor = models.Where(m => !m.Id.Contains('/')).ToList();

        var groups = withVendor
            .GroupBy(m => m.Id[..m.Id.IndexOf('/')])
            .Select(g => new ModelGroup(g.Key, g.OrderByDescending(m => m.CapabilityScore ?? double.MinValue).ThenBy(m => m.Id, StringComparer.OrdinalIgnoreCase).ToList()))
            .OrderBy(g => g.VendorLabel, StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (withoutVendor.Count > 0)
        {
            groups.Add(new ModelGroup(string.Empty, withoutVendor.OrderByDescending(m => m.CapabilityScore ?? double.MinValue).ThenBy(m => m.Id, StringComparer.OrdinalIgnoreCase).ToList()));
        }

        return groups;
    }

    private void ToggleExpanded(string groupKey)
    {
        if (!_expandedGroups.Add(groupKey))
        {
            _expandedGroups.Remove(groupKey);
        }
    }

    private void ToggleSelection(string key, bool isSelected)
    {
        if (isSelected)
        {
            _selected.Add(key);
        }
        else
        {
            _selected.Remove(key);
        }
    }

    private async Task RunFanoutAsync()
    {
        _isRunning = true;
        _results.Clear();

        var tasks = _selected.Select(async key =>
        {
            var parts = key.Split('|', 2);
            var providerId = parts[0];
            var model = parts[1];
            var provider = ProviderRegistry.Get(providerId);

            try
            {
                var apiKey = await ApiKeyStore.GetKeyAsync(providerId)
                    ?? throw new InvalidOperationException("No key saved for this provider.");
                var result = await provider.MeasureAsync(apiKey, model, _prompt);
                return new FanoutResult(providerId, provider.DisplayName, model, result, null);
            }
            catch (QuotaExceededException ex)
            {
                await ProviderSettingsStore.MarkModelUnavailableAsync(providerId, model);
                return new FanoutResult(providerId, provider.DisplayName, model, null,
                    $"{ex.Message} — hidden from Settings' picker now.");
            }
            catch (Exception ex)
            {
                return new FanoutResult(providerId, provider.DisplayName, model, null, ex.Message);
            }
        });

        var completed = await Task.WhenAll(tasks);
        _results.AddRange(completed);
        _isRunning = false;
    }

    private static string Format(int? value) => value?.ToString() ?? "not reported";
}
