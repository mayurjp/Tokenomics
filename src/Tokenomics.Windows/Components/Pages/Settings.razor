@page "/settings"
@using Tokenomics.Core.Providers
@using Tokenomics.Core.Storage
@inject ProviderRegistry ProviderRegistry
@inject IApiKeyStore ApiKeyStore
@inject IProviderSettingsStore ProviderSettingsStore

<h1>Settings</h1>
<p class="text-muted">Enter and test an API key for each provider. Keys are stored locally, encrypted.</p>

@foreach (var provider in ProviderRegistry.All)
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="card-title h5">@provider.DisplayName</h2>

            @if (_savedState.TryGetValue(provider.ProviderId, out var saved) && saved)
            {
                <p class="text-success">A key is already saved for this provider.</p>
            }

            <label class="form-label">API Key</label>
            <input type="password"
                   class="form-control"
                   @bind="_keyInputs[provider.ProviderId]"
                   @bind:event="oninput"
                   placeholder="Paste your API key" />

            <div class="mt-2">
                <button class="btn btn-primary" @onclick="() => TestAndSaveAsync(provider)" disabled="@IsBusy(provider.ProviderId)">
                    @(IsBusy(provider.ProviderId) ? "Testing..." : "Test & Save")
                </button>
                <button class="btn btn-outline-secondary ms-2" @onclick="() => ClearAsync(provider)" disabled="@IsBusy(provider.ProviderId)">
                    Clear key
                </button>
            </div>

            @if (_messages.TryGetValue(provider.ProviderId, out var message))
            {
                <p class="mt-2 @(_messageIsError.GetValueOrDefault(provider.ProviderId) ? "text-danger" : "text-success")">
                    @message
                </p>
            }

            @if (_modelsByProvider.TryGetValue(provider.ProviderId, out var models) && models.Count > 0)
            {
                <label class="form-label mt-3">Model</label>
                <select class="form-select" @bind="_selectedModel[provider.ProviderId]" @bind:after="() => SaveSelectedModelAsync(provider)">
                    @foreach (var model in models)
                    {
                        <option value="@model">@model</option>
                    }
                </select>
            }
            else if (saved)
            {
                <p class="text-muted mt-3">Using default model: @provider.DefaultModel (model list unavailable — @_modelListError.GetValueOrDefault(provider.ProviderId, "not loaded yet"))</p>
            }
        </div>
    </div>
}

@code {
    private readonly Dictionary<string, string> _keyInputs = new();
    private readonly Dictionary<string, bool> _savedState = new();
    private readonly Dictionary<string, string> _messages = new();
    private readonly Dictionary<string, bool> _messageIsError = new();
    private readonly Dictionary<string, List<string>> _modelsByProvider = new();
    private readonly Dictionary<string, string> _selectedModel = new();
    private readonly Dictionary<string, string> _modelListError = new();
    private readonly HashSet<string> _busy = new();

    protected override async Task OnInitializedAsync()
    {
        foreach (var provider in ProviderRegistry.All)
        {
            _keyInputs[provider.ProviderId] = string.Empty;
            var hasKey = await ApiKeyStore.HasKeyAsync(provider.ProviderId);
            _savedState[provider.ProviderId] = hasKey;

            if (hasKey)
            {
                var apiKey = await ApiKeyStore.GetKeyAsync(provider.ProviderId);
                if (apiKey is not null)
                {
                    await LoadModelsAsync(provider, apiKey);
                }
            }
        }
    }

    private bool IsBusy(string providerId) => _busy.Contains(providerId);

    private async Task TestAndSaveAsync(ILlmProvider provider)
    {
        var apiKey = _keyInputs.GetValueOrDefault(provider.ProviderId, string.Empty).Trim();
        if (string.IsNullOrEmpty(apiKey))
        {
            SetMessage(provider.ProviderId, "Enter a key first.", isError: true);
            return;
        }

        _busy.Add(provider.ProviderId);
        StateHasChanged();

        try
        {
            var result = await provider.TestConnectionAsync(apiKey);
            if (result.Success)
            {
                await ApiKeyStore.SaveKeyAsync(provider.ProviderId, apiKey);
                _savedState[provider.ProviderId] = true;
                _keyInputs[provider.ProviderId] = string.Empty;
                SetMessage(provider.ProviderId, "Connection succeeded — key saved.", isError: false);

                await LoadModelsAsync(provider, apiKey);
            }
            else
            {
                SetMessage(provider.ProviderId, result.ErrorMessage ?? "Connection failed.", isError: true);
            }
        }
        finally
        {
            _busy.Remove(provider.ProviderId);
        }
    }

    private async Task LoadModelsAsync(ILlmProvider provider, string apiKey)
    {
        try
        {
            var models = await provider.ListModelsAsync(apiKey);
            _modelsByProvider[provider.ProviderId] = models.ToList();
            _modelListError.Remove(provider.ProviderId);

            var savedModel = await ProviderSettingsStore.GetSelectedModelAsync(provider.ProviderId);
            _selectedModel[provider.ProviderId] = savedModel is not null && models.Contains(savedModel)
                ? savedModel
                : models.Contains(provider.DefaultModel) ? provider.DefaultModel : models.FirstOrDefault() ?? provider.DefaultModel;

            // Persist the resolved default so Measure's read-side doesn't need its own fallback logic.
            await ProviderSettingsStore.SaveSelectedModelAsync(provider.ProviderId, _selectedModel[provider.ProviderId]);
        }
        catch (Exception ex)
        {
            _modelListError[provider.ProviderId] = ex.Message;
        }
    }

    private async Task SaveSelectedModelAsync(ILlmProvider provider)
    {
        if (_selectedModel.TryGetValue(provider.ProviderId, out var model))
        {
            await ProviderSettingsStore.SaveSelectedModelAsync(provider.ProviderId, model);
        }
    }

    private async Task ClearAsync(ILlmProvider provider)
    {
        await ApiKeyStore.DeleteKeyAsync(provider.ProviderId);
        _savedState[provider.ProviderId] = false;
        _modelsByProvider.Remove(provider.ProviderId);
        SetMessage(provider.ProviderId, "Key cleared.", isError: false);
    }

    private void SetMessage(string providerId, string message, bool isError)
    {
        _messages[providerId] = message;
        _messageIsError[providerId] = isError;
    }
}
