# .NET build artifacts
bin/
obj/
*.user

# Visual Studio
.vs/

# MAUI / packaging
*.appx
*.appxbundle
*.appxupload
*.msix
*.msixbundle
*.msixupload

# User secrets are stored outside the repo (%APPDATA%\Microsoft\UserSecrets) —
# nothing secret should ever land in-tree, but guard against accidental copies anyway.
appsettings.Development.json
appsettings.*.local.json
.env
.env.*
!.env.example

# OS cruft
Thumbs.db
.DS_Store

# No server and no shared key any more — the visitor brings their own, held in their
# browser. Kept ignored so a stray local secrets file can never be committed.
.dev.vars

# Node
node_modules/
.wrangler/
